# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Decision threshold (5% default)
EDGE_THRESHOLD=0.05

# HTTP options
REQUEST_TIMEOUT=15
USER_AGENT=Mozilla/5.0 (TennisEdgeAgent/1.0)

# Optional free local brain (Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Optional Groq key (not required)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Public Polymarket market-data endpoint (no credentials)
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com/markets

# ESPN public endpoint
ESPN_TENNIS_SCOREBOARD=https://site.api.espn.com/apis/site/v2/sports/tennis/scoreboard
